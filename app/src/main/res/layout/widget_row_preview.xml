<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="8dp">

        <LinearLayout android:id="@+id/slot0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical" android:visibility="visible">
            <FrameLayout android:id="@+id/frame0" android:layout_width="42dp" android:layout_height="42dp">
                <ProgressBar android:id="@+id/ring0" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/ring" android:progress="85" android:progressTint="#4CD964" />
                <TextView android:id="@+id/rpct0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text="85%" />
            </FrameLayout>
            <TextView android:id="@+id/rname0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="10sp" android:text="갤럭시 S24" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical" android:visibility="visible">
            <FrameLayout android:id="@+id/frame1" android:layout_width="42dp" android:layout_height="42dp">
                <ProgressBar android:id="@+id/ring1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/ring" android:progress="62" android:progressTint="#4CD964" />
                <TextView android:id="@+id/rpct1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text="62%" />
            </FrameLayout>
            <TextView android:id="@+id/rname1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="10sp" android:text="레노버 탭" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical" android:visibility="visible">
            <FrameLayout android:id="@+id/frame2" android:layout_width="42dp" android:layout_height="42dp">
                <ProgressBar android:id="@+id/ring2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/ring" android:progress="40" android:progressTint="#4CD964" />
                <TextView android:id="@+id/rpct2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text="40%" />
            </FrameLayout>
            <TextView android:id="@+id/rname2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="10sp" android:text="🎧 갤럭시 버즈" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical" android:visibility="visible">
            <FrameLayout android:id="@+id/frame3" android:layout_width="42dp" android:layout_height="42dp">
                <ProgressBar android:id="@+id/ring3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/ring" android:progress="18" android:progressTint="#FFB020" />
                <TextView android:id="@+id/rpct3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:text="18%" />
            </FrameLayout>
            <TextView android:id="@+id/rname3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="10sp" android:text="갤럭시 워치" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/frame4" android:layout_width="42dp" android:layout_height="42dp">
                <ProgressBar android:id="@+id/ring4" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/ring"  />
                <TextView android:id="@+id/rpct4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"  />
            </FrameLayout>
            <TextView android:id="@+id/rname4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="10sp"  />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/frame5" android:layout_width="42dp" android:layout_height="42dp">
                <ProgressBar android:id="@+id/ring5" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/ring"  />
                <TextView android:id="@+id/rpct5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"  />
            </FrameLayout>
            <TextView android:id="@+id/rname5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:gravity="center" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="10sp"  />
        </LinearLayout>
</LinearLayout>
